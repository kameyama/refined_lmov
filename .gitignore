# 仮想環境・キャッシュ
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.DS_Store

# 計算のキャッシュと大きな中間データ
data/cache/
data/samples/
*.npy
*.npz

# 論文 PDF と補助ファイル（just fetch-refs で再取得する）。references/README.md だけを追跡する
references/*
!references/README.md


# LaTeX の中間ファイル（docs/paper）
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc
docs/paper/*.fls
docs/paper/*.fdb_latexmk

# K10 の 3 箱の \hat f（363 MB）は xz で圧縮した data/lmov/K10_3.json.xz だけを git に入れる
data/lmov/K10_3.json

# framing を記号として扱う判定の途中の値（scripts/framing_newton.py が再生成する）
data/framing/
# K7〜K9 の 3 箱の \hat N（各 21〜32 MB）は xz で圧縮した .json.xz だけを git に入れる。.txt の表は git に入れない（scripts/export_bps.py で再生成）
data/bps/K[789]_3.json
data/bps/K[789]_21.json
data/bps/K[789]_111.json
data/bps/K[789]_3.txt
data/bps/K[789]_21.txt
data/bps/K[789]_111.txt
# K10 の \hat N（2 箱は各 18 MB、3 箱は各 260 MB、.txt は最大 1.1 GB）。2 箱は .json.xz だけを git に入れる。3 箱も .json.xz（各 87〜90 MB）を git に入れる（2026-10-09、ユーザーの判断）
data/bps/K10_2.json
data/bps/K10_11.json
data/bps/K10_3.json
data/bps/K10_21.json
data/bps/K10_111.json
data/bps/K10_*.txt
!data/bps/K10_1.txt
docs/paper/ja/*.aux
docs/paper/ja/*.log
docs/paper/ja/*.fdb_latexmk
docs/paper/ja/*.fls
docs/paper/ja/*.out
docs/paper/ja/*.toc
docs/paper/ja/*.bbl
