λ = 2：W = (r**6*s**6 + r**6*s**4 + r**4*s**6 + 3*r**4*s**4 + 3*r**4*s**2 + r**2*s**4 + 3*r**2*s**2 + r**2 + s**2 + 1)**2/r**16；W − Y_λ² = 0
   C_λ = -(r - s)*(r + s)*(2*r**10*s**4 - r**8*s**10 - 2*r**8*s**8 + 4*r**8*s**4 + 4*r**8*s**2 - 4*r**6*s**8 - 7*r**6*s**6 + r**6*s**4 + 4*r**6*s**2 + 2*r**6 - 7*r**4*s**6 - 7*r**4*s**4 - 4*r**2*s**4 - 2*r**2*s**2 - s**2)/r**16；C/(q−t) = -(2*r**10*s**4 - r**8*s**10 - 2*r**8*s**8 + 4*r**8*s**4 + 4*r**8*s**2 - 4*r**6*s**8 - 7*r**6*s**6 + r**6*s**4 + 4*r**6*s**2 + 2*r**6 - 7*r**4*s**6 - 7*r**4*s**4 - 4*r**2*s**4 - 2*r**2*s**2 - s**2)/r**16
λ = 11：W = (r**2 + 1)**2*(s**2 + 1)**2*(r**2*s**2 + 1)**2/r**12；W − Y_λ² = 0
   C_λ = s**2*(r - s)*(r + s)*(r**2*s**2 + 1)**2/r**12；C/(q−t) = s**2*(r**2*s**2 + 1)**2/r**12
