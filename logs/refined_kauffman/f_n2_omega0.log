λ = 11：Ω^(0) の ν の冪 [2, 4, 6, 8, 10]
   ν^-2：s**2*(r**2*s**2 + 1)/(r**3*(s - 1)*(s + 1))
   ν^-4：-s**2*(r**2 + 1)*(s**2 + 1)*(r**2*s**2 + 1)/(r**5*(s - 1)*(s + 1))
   ν^-6：s**2*(r**2*s**2 + 1)*(r**4*s**2 + r**2*s**4 + 2*r**2*s**2 + r**2 + s**2)/(r**7*(s - 1)*(s + 1))
   最上の係数/X_λ = -r**3*s**2/((s - 1)*(s + 1)*(r**2*s**2 + r**2 + 1))
   最上の係数/Ŷ_λ = r**3*s**2/((r**2 + 1)*(s - 1)*(s + 1)*(s**2 + 1))
   (最上)²/((s³/r)X²) = r**7*s/((s - 1)**2*(s + 1)**2*(r**2*s**2 + r**2 + 1)**2)
λ = 2：Ω^(0) の ν の冪 [2, 4, 6, 8, 10]
   ν^-2：s**2*(r**2*s**2 + 1)**2/(r**5*(s - 1)*(s + 1))
   ν^-4：-s**2*(r**6*s**6 + r**6*s**4 + r**4*s**6 + 3*r**4*s**4 + 3*r**4*s**2 + r**2*s**4 + 3*r**2*s**2 + r**2 + s**2 + 1)/(r**7*(s - 1)*(s + 1))
   ν^-6：s**2*(r**8*s**6 + r**6*s**8 + 2*r**6*s**6 + 4*r**6*s**4 + r**6*s**2 + 2*r**4*s**6 + 3*r**4*s**4 + 4*r**4*s**2 + 2*r**2*s**4 + 2*r**2*s**2 + r**2 + s**2)/(r**9*(s - 1)*(s + 1))
   最上の係数/X_λ = -r**3*s**2*(r**2*s**2 + 1)**2/((s - 1)*(s + 1)*(r**6*s**6 + r**6*s**4 + 2*r**4*s**4 + 3*r**4*s**2 + 2*r**2*s**2 + r**2 + 1))
   最上の係数/Ŷ_λ = r**3*s**2*(r**2*s**2 + 1)**2/((s - 1)*(s + 1)*(r**6*s**6 + r**6*s**4 + r**4*s**6 + 3*r**4*s**4 + 3*r**4*s**2 + r**2*s**4 + 3*r**2*s**2 + r**2 + s**2 + 1))
   (最上)²/((s³/r)X²) = r**7*s*(r**2*s**2 + 1)**4/((s - 1)**2*(s + 1)**2*(r**6*s**6 + r**6*s**4 + 2*r**4*s**4 + 3*r**4*s**2 + 2*r**2*s**2 + r**2 + 1)**2)
f_(1,) の先頭：{1: -s*(r**2*s**2 + 1)/(r**2*(s - 1)*(s + 1)), 3: s*(r**2*s**2 + s**2 + 1)/(r**2*(s - 1)*(s + 1))}
f_(1, 1) の先頭：{2: s**2*(r - 1)*(r + 1)*(r**2*s**2 + 1)*(r**2*s**2 + r**2 + 1)/(2*r**6*(s - 1)*(s + 1)), 4: -s**2*(r - 1)*(r + 1)*(r**2*s**2 + s**2 + 1)*(r**2*s**2 + r**2 - r*s + 1)*(r**2*s**2 + r**2 + r*s + 1)/(2*r**8*(s - 1)*(s + 1))}
f_(2,) の先頭：{2: s**2*(r**2 + 1)*(r**2*s**2 + 1)*(r**2*s**2 - r**2 + 1)/(2*r**6*(s - 1)*(s + 1)), 4: -s**2*(r**2 + 1)*(r**6*s**6 - r**6*s**2 + r**4*s**6 + 2*r**4*s**4 + r**4*s**2 - r**4 + r**2*s**4 + 2*r**2*s**2 + s**2 + 1)/(2*r**8*(s - 1)*(s + 1))}
